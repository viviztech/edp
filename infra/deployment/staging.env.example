# Operator-owned files must be outside the repository, non-symlink and restricted.
# Required images use registry/name@sha256:<64 lowercase hex>. No mutable tags.
API_IMAGE=
WEB_IMAGE=
EDGE_IMAGE=
API_ENV_FILE=
WORKER_ENV_FILE=
MIGRATION_ENV_FILE=
WEB_ENV_FILE=
NGINX_CONFIG_FILE=
TLS_CERTIFICATE_FILE=
TLS_PRIVATE_KEY_FILE=
STAGING_PRIVATE_NETWORK=
STAGING_EDGE_NETWORK=
STAGING_BIND_IP=
TRUSTED_PROXY_IPS=
WEB_ORIGIN=
# JSON array containing exactly WEB_ORIGIN, e.g. ["https://staging.example.org"].
CORS_ORIGINS=
# Runtime files: APP_ENV=staging; distinct DATABASE_URL runtime users; private
# REDIS_URL; identical server-only BFF_KEY in API/web; AUTH_DELIVERY_KEY where
# approved; files/maintenance/SMTP/enquiries stay disabled in this initial contract.
# Migration file alone contains the schema-owner DATABASE_URL.
# Never run 'docker compose config' into logs: it may resolve secret environment.
# Use 'docker compose --env-file <file> -f staging.compose.json config --quiet'.
