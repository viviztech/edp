pid /tmp/nginx.pid;
error_log /dev/null crit;
events { worker_connections 512; }
http {
  server_tokens off;
  client_body_temp_path /tmp/client-body;
  proxy_temp_path /tmp/proxy;
  log_format safe '$time_iso8601 $request_method $status $request_time';
  access_log /dev/stdout safe;
  limit_conn_zone $binary_remote_addr zone=per_address:10m;
  limit_req_zone $binary_remote_addr zone=per_address_rate:10m rate=10r/s;
  upstream web { server web:3000; keepalive 16; }
  upstream api { server api:8000; keepalive 16; }
  server { listen 8443 ssl default_server; ssl_reject_handshake on; }
  server {
    listen 8443 ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:10m;
    client_max_body_size 10m;
    client_body_timeout 30s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 90s;
    limit_conn per_address 20;
    limit_req zone=per_address_rate burst=30 nodelay;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    proxy_connect_timeout 5s;
    proxy_send_timeout 90s;
    proxy_read_timeout 90s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_next_upstream off;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host __PUBLIC_HOST__;
    proxy_set_header X-Forwarded-Host __PUBLIC_HOST__;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded '';
    proxy_set_header X-Request-ID '';
    location = /health { return 404; }
    location = /ready { return 404; }
    location = /docs { return 404; }
    location = /redoc { return 404; }
    location = /openapi.json { return 404; }
    location ^~ /api/v1/ { proxy_pass http://api; }
    location / { proxy_pass http://web; }
  }
}
