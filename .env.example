# Local Compose only. Generate a random URL-safe value; no shared default password.
POSTGRES_DB=edp_dev
POSTGRES_USER=edp_dev
POSTGRES_PASSWORD=

# Random server-to-server key, at least 32 characters.
BFF_KEY=
# Fernet key for development-only encrypted verification/reset queue.
AUTH_DELIVERY_KEY=

# Local private LMS file adapter. The Compose directory is mounted read-only.
LMS_MATERIAL_SIGNING_KEY=
LMS_MATERIAL_ACCESS_SECONDS=300

# Meta connection requires a unique Fernet key, a deployment-pinned Graph version,
# and an approved retention window before webhook ingestion is enabled.
META_SECRET_KEY=
META_GRAPH_API_VERSION=
META_EVENT_RETENTION_DAYS=

# Durable CRM export engineering limits shared by API, worker and Beat.
CRM_EXPORT_LEASE_SECONDS=120
CRM_EXPORT_MAX_ATTEMPTS=3
CRM_EXPORT_RECOVERY_BATCH_SIZE=25
CRM_EXPORT_MAX_BYTES=10485760
# Approved output-retention days only; no privacy default or automatic policy approval.
CRM_EXPORT_RETENTION_DAYS=

# Secure-file policy administration works while collection and maintenance are off.
# Publishing a policy does not approve its wording or enable real collection.
FILES_ENABLED=false
FILES_MAINTENANCE_ENABLED=false
FILES_STORAGE_BACKEND=
FILES_LOCAL_ROOT=
FILES_TEMP_ROOT=
# Operational ceiling only; each published policy must supply its own limits.
FILES_MAX_BYTES=10485760
FILES_UPLOAD_LEASE_SECONDS=120
FILES_SCAN_LEASE_SECONDS=120
FILES_SCAN_MAX_ATTEMPTS=3
FILES_CLEANUP_BATCH_SIZE=25
# New metadata intents per actor/organization in the existing 15-minute window.
FILES_INTENT_LIMIT_PER_WINDOW=60
FILES_S3_BUCKET=
FILES_S3_ENDPOINT_URL=
FILES_S3_REGION=
FILES_S3_ENCRYPTION=
# For aws:kms, use the canonical key ARN returned by S3.
FILES_S3_KMS_KEY_ID=
# Choose an explicit key pair OR an explicitly opted-in workload identity.
FILES_S3_USE_IAM_ROLE=false
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
FILES_S3_SESSION_TOKEN=
# Private clamd connection only. Run clamd with TZ=UTC and fresh signatures.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_MAX_REPLY_BYTES=4096
CLAMAV_MAX_SIGNATURE_AGE_SECONDS=
