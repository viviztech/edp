APP_ENV=local
# Use an isolated local database and a URL-encoded password; never production.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://127.0.0.1:3001"]

BFF_KEY=
AUTH_DELIVERY_KEY=
# Global identity delivery. Development is a no-delivery local/test capability.
AUTH_DELIVERY_BACKEND=development
AUTH_SMTP_ENABLED=false
AUTH_TEMPLATES_APPROVED=false
AUTH_CANONICAL_ORIGIN=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_TLS_MODE=implicit
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_ADDRESS=
# Approved lifecycle only; no retention is inferred from token validity.
AUTH_DELIVERY_RETENTION_DAYS=
AUTH_DELIVERY_MAX_ATTEMPTS=3
AUTH_DELIVERY_BATCH_SIZE=25
AUTH_DELIVERY_LEASE_SECONDS=120
AUTH_SMTP_STAGE_TIMEOUT_SECONDS=3
AUTH_SMTP_TOTAL_TIMEOUT_SECONDS=15
AUTH_SMTP_MAX_MESSAGE_BYTES=32768
PARTICIPANT_NOTIFICATION_RETENTION_DAYS=
PARTICIPANT_NOTIFICATION_BATCH_SIZE=25
PARTICIPANT_NOTIFICATION_MAX_ATTEMPTS=3
ACCESS_TOKEN_SECONDS=600
SESSION_SECONDS=1209600

# Private LMS files are resolved below this directory. Production requires a separate signing key.
LMS_MATERIAL_ROOT=
LMS_MATERIAL_SIGNING_KEY=
LMS_MATERIAL_ACCESS_SECONDS=300

# Separate Fernet key for encrypted provider credentials.
META_SECRET_KEY=
# Pin an approved Meta Graph API version (for example vNN.N) per deployment.
META_GRAPH_API_VERSION=
META_GRAPH_BASE_URL=https://graph.facebook.com
# Set only after the webhook evidence retention policy is approved.
META_EVENT_RETENTION_DAYS=
# Set only after in-app notification retention is approved.
NOTIFICATION_RETENTION_DAYS=

# Engineering bounds for durable CRM export execution; API/worker/Beat must agree.
CRM_EXPORT_LEASE_SECONDS=120
CRM_EXPORT_MAX_ATTEMPTS=3
CRM_EXPORT_RECOVERY_BATCH_SIZE=25
CRM_EXPORT_MAX_BYTES=10485760
# No disposal policy is inferred from the 24-hour download access deadline.
# Configure only after output retention is approved; empty disables scheduled disposal.
CRM_EXPORT_RETENTION_DAYS=

# Open enquiries only after both localized consent texts and privacy notices are approved.
# The default keeps the public form unavailable; never insert placeholder policy into production.
CONTACT_ENQUIRIES_ENABLED=false
CONTACT_PRIVACY_VERSION=v1
CONTACT_PRIVACY_NOTICE_URL_EN=
CONTACT_PRIVACY_NOTICE_URL_TA=
CONTACT_CONSENT_TEXT_EN=
CONTACT_CONSENT_TEXT_TA=
