API_INTERNAL_URL=http://localhost:8000
WEB_ORIGIN=http://127.0.0.1:3001
# Generate a random value of at least 32 characters, identical to API BFF_KEY.
BFF_KEY=
# Local loopback HTTP only. Set true for HTTPS staging/production.
COOKIE_SECURE=false

# Organization UUID used for public CMS; leave empty until provisioned.
PUBLIC_ORGANIZATION_ID=
# Public launch demo uses fictional data in browser memory, separate from real accounts.
PUBLIC_DEMO_ENABLED=false
# Enable only after production email and an approved application cycle are verified.
PUBLIC_SELF_SERVICE_ENABLED=false
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_WHATSAPP=
