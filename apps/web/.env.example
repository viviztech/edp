API_INTERNAL_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Generate a random value of at least 32 characters, identical to API BFF_KEY.
BFF_KEY=
# Local loopback HTTP only. Set true for HTTPS staging/production.
COOKIE_SECURE=false

# Organization UUID used for public CMS; leave empty until provisioned.
PUBLIC_ORGANIZATION_ID=
